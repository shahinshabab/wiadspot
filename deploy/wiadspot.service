[Unit]
Description=WiadSpot (gunicorn)
After=network.target

[Service]
User=wiadspot
Group=www-data
WorkingDirectory=/srv/wiadspot
EnvironmentFile=/srv/wiadspot/.env
ExecStart=/srv/wiadspot/venv/bin/gunicorn config.wsgi:application --bind unix:/srv/wiadspot/gunicorn.sock --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
