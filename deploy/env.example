# Copy to /srv/wiadspot/.env, generate SECRET_KEY, and chmod 600 the file.
DEBUG=False
# path: http://<server-ip>/client/ (no domain needed); subdomain: client.<domain>
ROUTING_MODE=path
# Set True once the site is served over HTTPS (secure cookies need it).
SECURE_COOKIES=False
SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=wiadspot.com,www.wiadspot.com,client.wiadspot.com,owner.wiadspot.com,manager.wiadspot.com,admin.wiadspot.com,partner.wiadspot.com,clients.wiadspot.com,ads.wiadspot.com,127.0.0.1,localhost
DATABASE_URL=sqlite:////srv/wiadspot/var/db.sqlite3
STATIC_ROOT=/srv/wiadspot/var/static
MEDIA_ROOT=/srv/wiadspot/var/media
# Optional integration credentials; populate privately when available.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
FAS_KEY=
